#!/usr/bin/make -f

#export DH_VERBOSE=1
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_usrlocal:

override_dh_installexamples:
	dh_installexamples "examples/sxhkdrc"
	dh_installexamples "examples/autostart"

override_dh_compress:
	dh_compress -Xexamples

# Upstream ships the sxhkdrc example with an executable bit; it is a
# config file, not a script.
override_dh_fixperms:
	dh_fixperms
	chmod 0644 debian/berry/usr/share/doc/berry/examples/sxhkdrc
